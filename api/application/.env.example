# Banco
MONGODB_URI=mongodb://localhost:27017/orbit

# Sessão e login (Cloudflare Access na frente do front)
JWT_SECRET=change-me-with-at-least-32-random-chars
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
ALLOWED_EMAIL_DOMAIN=example.com
ENABLE_DEV_LOGIN=false
# true só em ambiente local sem HTTPS: tira o Secure do cookie de sessão
SESSION_COOKIE_INSECURE=false
# Quantos proxies confiáveis existem antes da API (o rewrite do front conta 1). Com 0 atrás de proxy, todos os clientes dividem o mesmo limite de login por endereço.
TRUST_PROXY_HOPS=1

# Webhook do GitHub (opcional: a sincronização por leitura funciona sem ele)
GITHUB_WEBHOOK_SECRET=

# Sincronização do GitHub só de leitura. Token fine-grained com Metadata, Contents, Pull requests, Commit statuses e Checks em leitura. Vazio desliga a sincronização.
GITHUB_TOKEN=
# Repositórios sincronizados, separados por vírgula (owner/nome)
GITHUB_REPOSITORIES=PedroProni/orbit-api,PedroProni/orbit-frontend,PedroProni/orbit
# Intervalo da sincronização em ms; 0 desliga o agendador
GITHUB_SYNC_INTERVAL_MS=300000
# Só para teste local contra um GitHub falso; vazio usa https://api.github.com
GITHUB_API_URL=

# Automações. Chave AES-256-GCM em base64 (32 bytes) para cifrar o segredo dos webhooks; sem ela, automações com webhook são recusadas. Gere com: openssl rand -base64 32
AUTOMATION_SECRET_KEY=
# Intervalo em ms da verificação de gatilhos por data; 0 desliga o agendador
AUTOMATION_DATE_INTERVAL_MS=60000
# Só para desenvolvimento: true libera webhooks para http e endereços privados. Ignorado quando NODE_ENV=production
AUTOMATION_WEBHOOK_ALLOW_PRIVATE=false

# Armazenamento S3 (MinIO local; na AWS deixar S3_ENDPOINT, S3_PUBLIC_ENDPOINT e as chaves vazios para usar a task role)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=orbit
S3_ACCESS_KEY=orbit
S3_SECRET_KEY=orbit-secret
PRESIGN_TTL_SECONDS=300

# CORS (origem do front)
LOCAL_DOMAIN=http://localhost:3001
MOBILE_DOMAIN=
PROD_DOMAIN=

# Swagger
SWAGGER_AUTH_USERNAME=admin
SWAGGER_AUTH_PASSWORD=admin

# App
PORT=3000
# Interface da API. Vazio escuta em todas; use 127.0.0.1 quando só um proxy local deve alcançar a API.
BIND_HOST=
NODE_ENV=development
SCHEDULER_INTERVAL_MS=60000
